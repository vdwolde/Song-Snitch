{
  "name": "song-snitch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Song Snitch — local-network party game: guess who submitted the song",
  "author": "Thomas van der Wolde (vdWolde) <https://vdwolde.com/>",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"cross-env UI_ORIGIN=http://127.0.0.1:5173 tsx watch server/index.ts\"",
    "build": "vite build",
    "serve": "tsx server/index.ts",
    "start": "npm run build && npm run serve",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/*.test.ts"
  },
  "dependencies": {
    "@fastify/compress": "9.3.0",
    "@fastify/static": "10.1.8",
    "@fastify/websocket": "11.3.6",
    "fastify": "5.12.7",
    "lucide-react": "1.66.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/spotify-web-playback-sdk": "0.1.19",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
