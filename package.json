{
  "name": "song-snitch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Song Snitch — local single-user data tool",
  "author": "Thomas van der Wolde (vdWolde) <https://vdwolde.com/>",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"vite\" \"cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch server/index.ts\"",
    "build": "vite build",
    "serve": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx server/index.ts",
    "start": "npm run build && npm run serve",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --test server/*.test.ts"
  },
  "dependencies": {
    "@fastify/compress": "9.2.0",
    "@fastify/multipart": "10.1.1",
    "@fastify/static": "10.1.3",
    "exceljs": "4.4.0",
    "fastify": "5.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "tsx": "4.23.12",
    "typescript": "5.7.3",
    "vite": "6.0.11"
  }
}
